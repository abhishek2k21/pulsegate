<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
    <!-- Exclude generated code and Lombok-generated bytecode -->
    <Match>
        <Class name="~.*\.*Builder.*" />
    </Match>
    <Match>
        <Package name="~com\.pulsegate\.model\..*" />
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2" />
    </Match>
    <!-- Exclude test classes -->
    <Match>
        <Class name="~.*\.*Test.*" />
    </Match>
</FindBugsFilter>
