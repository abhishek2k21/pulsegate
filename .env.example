# =============================================================
# PulseGate — Environment Variables Reference
# Copy to .env for local development (never commit .env)
# =============================================================

# ── Database ──────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=pulsegate
POSTGRES_USER=pulsegate
POSTGRES_PASSWORD=change_me_in_production

# ── Redis ─────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=   # Uncomment for Redis with AUTH

# ── Kafka ─────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ── Security / OAuth2 ─────────────────────────────────────────
# Leave empty to disable JWT authentication (dev only)
JWT_JWKS_URI=

# Examples:
#   Keycloak:  http://keycloak:8080/realms/pulsegate/protocol/openid-connect/certs
#   Auth0:     https://YOUR_DOMAIN.auth0.com/.well-known/jwks.json
#   AWS Cognito: https://cognito-idp.REGION.amazonaws.com/POOL_ID/.well-known/jwks.json

# ── Application ───────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=dev

# ── Observability ─────────────────────────────────────────────
# Grafana Cloud (optional)
# GRAFANA_CLOUD_URL=
# GRAFANA_CLOUD_API_KEY=

# ── AWS (for EC2 deployment) ──────────────────────────────────
# AWS_REGION=ap-south-1
# AWS_EC2_HOST=your-ec2-public-ip
# ECR_REGISTRY=your-account.dkr.ecr.ap-south-1.amazonaws.com
